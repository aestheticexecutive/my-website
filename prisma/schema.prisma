// Generic per-member, per-tool JSON storage. Replaces the old localStorage-only
// persistence used by the /members resource tools. Runs against the real
// Prisma Postgres instance (see .env.local) — both locally and in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MemberToolData {
  userId    String
  toolKey   String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, toolKey])
}
